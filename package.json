{
	"name": "vecmo",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "vite",
		"dev:profile": "vite --profile",
		"session": "bun scripts/dev-session.ts",
		"build": "tsc -b && vite build",
		"check": "biome check . --max-diagnostics=none && oxlint . --ignore-pattern 'artifacts/**' --ignore-pattern '**/runtime-sampler.generated.ts' --ignore-pattern 'public/tutorial-exports/**' && bun run check:arch && bun run check:source-disposition && bun run check:authoring-parity && bun run check:tokens && bun run check:agent-contract && bun run check:product-knowledge && bun run check:public-english && bun run check:runtime-sampler && bun run check:webgl-player && bun run check:runtime-player-declarations && bun run check:reference-scenes && bun run check:reference-scenes-fresh && bun run check:residual-closure && tsc -b",
		"check:arch": "bun scripts/check-architecture.ts",
		"check:source-disposition": "bun scripts/check-source-disposition.ts",
		"check:authoring-parity": "bun scripts/check-authoring-parity.ts",
		"check:agent-contract": "bun scripts/check-agent-contract.ts",
		"check:tokens": "bun scripts/check-design-tokens.ts",
		"check:product-knowledge": "bun scripts/check-product-knowledge.ts",
		"check:public-english": "bun scripts/check-public-english.ts",
		"check:runtime-sampler": "bun scripts/check-runtime-sampler.ts",
		"check:webgl-player": "bun scripts/check-webgl-player.ts",
		"check:runtime-player-declarations": "bun scripts/check-runtime-player-declarations.ts",
		"check:reference-scenes": "bun scripts/check-reference-scenes.ts",
		"check:reference-scenes-fresh": "bun scripts/check-reference-scenes-fresh.ts",
		"check:residual-closure": "bun scripts/check-residual-closure.ts",
		"gen:runtime-sampler": "bun scripts/generate-runtime-sampler.ts",
		"gen:camera-runtime-verification": "bun scripts/generate-camera-runtime-verification.ts",
		"gen:random-pulse-candidate-packet": "bun scripts/generate-random-pulse-candidate-packet.ts",
		"gen:count-growth-candidate-packet": "bun scripts/generate-count-growth-candidate-packet.ts",
		"gen:residual-motion-packets": "bun scripts/generate-residual-motion-packets.ts",
		"gen:versioned-expression-binding-contract": "bun scripts/generate-versioned-expression-binding-contract.ts",
		"gen:noise-gradient-cube-probe": "bun scripts/generate-noise-gradient-cube-probe.ts",
		"gen:reference-scenes": "bun scripts/generate-reference-scenes.ts",
		"gen:babylon-qa-probe": "bun scripts/gen-babylon-qa-probe.ts",
		"gen:babylon-studio-env": "bun scripts/gen-babylon-studio-env.ts",
		"format": "biome format --write .",
		"lint": "biome lint . --max-diagnostics=none && oxlint . --ignore-pattern 'artifacts/**' --ignore-pattern '**/runtime-sampler.generated.ts' --ignore-pattern 'public/tutorial-exports/**'",
		"agent:bridge": "bun scripts/agent-bridge-relay.ts",
		"agent:bridge:poke": "bun scripts/agent-bridge-poke.ts",
		"agent:bridge:smoke": "bun scripts/smoke-agent-bridge.ts",
		"program-surface:bridge": "bun scripts/program-surface-bridge.ts",
		"vmactl": "bun scripts/vmactl.ts",
		"mcp:agent": "bun scripts/vma-agent-mcp.ts",
		"project:package": "bun scripts/package-portable-project.ts",
		"mcp:agent:smoke": "bun scripts/smoke-vma-agent-mcp.ts",
		"pixel-art:plan": "bun scripts/pixel-art-object-plan.ts",
		"sample:preflight": "bun scripts/sample-production-preflight.ts",
		"motion:preflight": "bun scripts/motion-production-preflight.ts",
		"preview": "vite preview"
	},
	"dependencies": {
		"@motion-surface/editor-kernel": "workspace:*",
		"@babylonjs/core": "9.19.0",
		"@babylonjs/loaders": "9.19.0",
		"@base-ui/react": "^1.6.0",
		"@phosphor-icons/react": "^2.1.10",
		"@polar-sh/checkout": "^0.3.0",
		"@radix-ui/colors": "^3.0.0",
		"@tailwindcss/vite": "^4.3.1",
		"clsx": "^2.1.1",
		"immer": "11.1.8",
		"mediabunny": "^1.52.1",
		"nanoid": "^5.1.11",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.1",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "^2.5.0",
		"@cfworker/json-schema": "^4.1.1",
		"@modelcontextprotocol/server": "2.0.0-alpha.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/typescript6": "^6.0.2",
		"@vitejs/plugin-react": "^6.0.2",
		"@webgpu/types": "^0.1.71",
		"babel-plugin-react-compiler": "^1.0.0",
		"esbuild": "0.28.1",
		"oxlint": "^1.70.0",
		"sharp": "0.34.5",
		"typescript": "~7.0.2",
		"vite": "^8.0.16"
	}
}
